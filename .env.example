OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

ALLOW_LIVE_TRADING=false

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/portfolio

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=paper-agent@example.local
EMAIL_TO=user@example.local

ENABLE_SCHEDULER=true
AGENT_RUN_CRON=35 9 * * 1-5
DRY_RUN=false

MAX_ORDER_NOTIONAL_USD=100
MAX_DAILY_TURNOVER_USD=300
MAX_ORDERS_PER_DAY=5

ALLOWED_SYMBOLS=VT,VTI,VEA,VWO,BND

NEWS_RSS_FEEDS=https://feeds.finance.yahoo.com/rss/2.0/headline?s=VT&region=US&lang=en-US
